---
import Attributions from "./Attributions.astro";
---

<style>
  footer {
    background-color: white;
    box-sizing: border-box;
    width: 100%;
    overflow-x: hidden;
  }
  .social-container {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width: 100%;
    gap: 2rem;
    box-sizing: border-box;
  }

  .social-container > ul {
    flex: 0 0 auto;
    margin: 0;
    padding: 0;
  }

  .social-container > ul > li {
    list-style: none;
  }

  .social-container > :last-child {
    flex: 0 0 40%;
    max-width: 40%;
  }
</style>

<footer>
  <div class="social-container">
    <Attributions />
    <a class="suppot-me" href='https://ko-fi.com/E5H6296HUR' target='_blank'><img height='36' style='border:0px;height:36px;' src='https://storage.ko-fi.com/cdn/kofi6.png?v=6' alt='Buy Me a Coffee at ko-fi.com' /></a>
  </div>
</footer>